{
  "name": "Copy billing mail to finance",
  "conditions": [
    { "match_type": "sender", "operator": "ends_with", "value": "@billing.example.com" },
    { "match_type": "header", "operator": "not_empty", "header_key": "X-Invoice-Id" }
  ],
  "destinations": [
    { "email": "finance@example.com" }
  ]
}
